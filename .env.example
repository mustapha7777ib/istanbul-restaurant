# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (Prisma + app)
DATABASE_URL="postgresql://USER@localhost:5432/istanbul_dev"
# Separate database used by `pnpm test` (it is wiped between test files)
TEST_DATABASE_URL="postgresql://USER@localhost:5432/istanbul_test"

# Public base URL. QR codes encode `${APP_URL}/t/<token>`, so set the real
# domain before printing table cards. For phone testing on Wi-Fi use your
# computer's LAN address, e.g. http://192.168.1.20:3000
APP_URL="http://localhost:3000"
PORT=3000

# Long random strings: `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
SESSION_SECRET=""
# Shared secret between server.ts and the internal escalation endpoint
INTERNAL_SECRET=""

# Web Push (waiter pings with the phone locked): `pnpm exec web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
